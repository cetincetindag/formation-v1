generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Form {
  id        String     @id @default("custom_id") // Custom ID will be overridden by nanoid in code
  password  String
  data      Json 
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  responses Response[]
}

model Response {
  id        String   @id @default(cuid())
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  form      Form     @relation(fields: [formId], references: [id])
  formId    String

  @@index([formId])
}
